import pandas as pd
from tqdm import tqdm

# Leitura do arquivo CSV
path = r'C:\Users\Reinaldo Araujo\Documents\sabesp\Base_Campanha_ 2024-03-08\base-utf8-converted.csv'

# Lê o arquivo diretamente em UTF-8
df = pd.read_csv(path, delimiter=';', encoding='utf-8')

# Remove os números duplicados e salva em um novo arquivo
numeros_duplicados = df[df.duplicated(subset=['NUM_CELULAR'])]
numeros_duplicados.to_csv(r'C:\Users\Reinaldo Araujo\Documents\sabesp\Base_Campanha_ 2024-03-08\numeros_duplicados.csv', index=False)

# Cria uma nova coluna para armazenar os números de celular atualizados
df['NUM_CELULAR_ATUALIZADO'] = ''

# Adiciona +55 na frente dos números com tqdm
progress_bar = tqdm(total=len(df))
for index, row in df.iterrows():
    numero_celular = '55' + str(row['NUM_CELULAR'])
    df.at[index, 'NUM_CELULAR_ATUALIZADO'] = numero_celular
    progress_bar.update(1)

# Remove as linhas duplicadas com base na coluna "NUM_CELULAR_ATUALIZADO"
df = df.drop_duplicates(subset=['NUM_CELULAR_ATUALIZADO'])

# Salva o arquivo atualizado sem duplicatas
df.to_csv(r'C:\Users\Reinaldo Araujo\Documents\sabesp\Base_Campanha_ 2024-03-08\base_atualizada_sem_duplicados.csv', index=False, sep=';')
